{
  "name": "anomaly-packer",
  "description": "Anomaly Packer is a utility package for STALKER Anomaly creators to help them develop addons at speed with TypeScript's type-safety and game-oriented build tools.",
  "keywords": [
    "stalker",
    "anomaly"
  ],
  "version": "0.1.1",
  "author": {
    "url": "https://github.com/piscopancer",
    "name": "piscopancer"
  },
  "repository": {
    "url": "https://github.com/piscopancer/anomaly-packer"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "anomaly-packer": "tsx src/cli/anomaly-packer.ts",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "tsdown && changeset publish"
  },
  "bin": {
    "anomaly-packer": "dist/cli/anomaly-packer.mjs"
  },
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cli-table3": "^0.6.5",
    "prettier": "^3.9.5",
    "tsdown": "^0.22.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "fast-xml-parser": "^5.9.3",
    "iconv-lite": "^0.7.3",
    "lua-types": "^2.14.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simplified-jsx-to-ast": "^0.4.0",
    "typescript-to-lua": "^1.37.0"
  }
}
